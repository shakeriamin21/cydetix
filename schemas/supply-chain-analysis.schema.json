              }
            },
            "required": [
              "from",
              "to",
              "relationship",
              "evidenceIds"
            ],
            "additionalProperties": false
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "packageId": {
                "type": "string",
                "pattern": "^package:[a-f0-9]{16}$"
              },
              "path": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "packageId",
              "path"
