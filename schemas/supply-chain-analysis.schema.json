        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^package:[a-f0-9]{16}$"
              },
              "ecosystem": {
                "type": "string",
                "const": "npm"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "purl": {
                "type": "string",
                "pattern": "^pkg:npm\\/"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "direct",
                  "dev",
                  "optional",
                  "peer",
                  "transitive"
                ]
              },
              "resolved": {
                "type": "boolean"
              },
              "integrity": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "registry",
                  "git",
                  "http",
                  "workspace",
                  "unknown"
                ]
              },
              "dev": {
                "type": "boolean"
              },
              "optional": {
                "type": "boolean"
              },
              "evidenceIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^supply-evidence:[a-f0-9]{16}$"
                }
              }
