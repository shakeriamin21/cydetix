          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transitiveCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "ecosystems",
        "manifests",
        "lockfiles",
        "lifecycleScripts",
        "packages",
        "edges",
        "paths",
        "directCount",
        "transitiveCount",
        "limitations"
      ],
      "additionalProperties": false
    },
    "advisories": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
