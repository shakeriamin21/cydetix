          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "NOT_PRESENT",
            "UNSUPPORTED"
          ]
        },
        "ecosystems": {
          "type": "array",
          "items": {
            "type": "string",
            "const": "npm"
          }
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lockfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rootComponent": {
          "type": "string",
          "minLength": 1
        },
        "lifecycleScripts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "manifest": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "enum": [
                  "preinstall",
                  "install",
                  "postinstall",
                  "prepare"
                ]
              },
              "location": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "object",
