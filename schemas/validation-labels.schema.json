{
  "$id": "https://cydetix.dev/schemas/v1/validation-labels.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "corpusId": {
      "type": "string",
      "minLength": 1
    },
    "expectedCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "expected": {
            "type": "string",
            "enum": [
              "VULNERABLE",
              "SECURE"
            ]
          },
          "languageCompatible": {
            "type": "boolean"
          },
          "ruleCompatible": {
            "type": "boolean"
          },
          "expectedUnknown": {
            "default": false,
            "type": "boolean"
          },
          "cwe": {
            "type": "string",
            "pattern": "^CWE-\\d+$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "caseId",
          "ruleId",
          "path",
          "expected",
          "languageCompatible",
          "ruleCompatible",
          "expectedUnknown",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "manualAdjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "disposition": {
            "type": "string",
            "enum": [
              "TRUE_POSITIVE",
              "FALSE_POSITIVE",
              "TRUE_NEGATIVE",
              "FALSE_NEGATIVE",
              "EXPECTED_BUT_DUPLICATE",
              "UNKNOWN",
              "UNSUPPORTED",
              "NOT_APPLICABLE",
              "NEEDS_DOMAIN_CONTEXT"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "projectDocumentation": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "caseId",
          "ruleId",
          "path",
          "disposition",
          "reviewer",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "completeness": {
      "type": "string",
      "enum": [
        "COMPLETE_APPLICABLE_LABELS",
        "PARTIAL",
        "FINDINGS_ONLY"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "corpusId",
    "expectedCases",
    "manualAdjudications",
    "completeness"
  ],
  "additionalProperties": false
}
