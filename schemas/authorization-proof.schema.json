{
  "$id": "https://cydetix.dev/schemas/v1/authorization-proof.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^proof:[a-f0-9]{16}$"
    },
    "invariant": {
      "type": "string",
      "enum": [
        "object-authorization",
        "tenant-isolation"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "PROVEN",
        "VIOLATED",
        "UNKNOWN"
      ]
    },
    "routeId": {
      "type": "string",
      "pattern": "^route:[a-f0-9]{16}$"
    },
    "resourceOperationId": {
      "type": "string",
      "pattern": "^resource:[a-f0-9]{16}$"
    },
    "subjectIdentityFactIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^identity:[a-f0-9]{16}$"
      }
    },
    "evidencePath": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "route",
              "call",
              "identity",
              "enforcement",
              "resource",
              "credential",
              "authentication",
              "session",
              "token",
              "oauth",
              "validation",
              "revocation",
              "password-reset",
              "dependency",
              "advisory",
              "workflow",
              "secret"
            ]
          },
          "irId": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "line",
                  "column",
                  "offset"
                ],
                "additionalProperties": false
              },
              "end": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "line",
                  "column",
                  "offset"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "path",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "order",
          "kind",
          "irId",
          "location",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "reachability": {
      "type": "string",
      "enum": [
        "unknown",
        "unlikely",
        "possible",
        "likely",
        "confirmed"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "invariant",
    "state",
    "routeId",
    "resourceOperationId",
    "subjectIdentityFactIds",
    "evidencePath",
    "explanation",
    "confidence",
    "reachability"
  ],
  "additionalProperties": false
}
