{
  "$id": "https://cydetix.dev/schemas/v1/application-dataflow.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "engineVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "completeness": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNSUPPORTED",
        "TRUNCATED"
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "filesAnalyzed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "astNodesVisited": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "factsCreated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pathsConsidered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncationEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "filesAnalyzed",
        "astNodesVisited",
        "factsCreated",
        "pathsConsidered",
        "iterations",
        "truncationEvents"
      ],
      "additionalProperties": false
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "reasonCodes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "EXACT_LOCAL_TRANSFORM",
                "DYNAMIC_EXPRESSION",
                "AMBIGUOUS_SEMANTICS",
                "BUSINESS_POLICY_REQUIRED",
                "AUTHORIZATION_POLICY_REQUIRED",
                "SCHEMA_CHANGE_REQUIRED",
                "CROSS_MODULE_UNCERTAINTY",
                "UNSUPPORTED_FRAMEWORK_PATTERN",
                "INSUFFICIENT_DATAFLOW_PROOF",
                "SANITIZER_UNKNOWN",
                "VERIFICATION_INSUFFICIENT",
                "MULTI_FILE_SEMANTIC_CHANGE",
                "ARCHITECTURE_CHANGE_REQUIRED"
              ]
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ruleId",
          "path",
          "line",
          "reasonCodes",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "completeness",
    "metrics",
    "unknowns",
    "limitations"
  ],
  "additionalProperties": false
}
