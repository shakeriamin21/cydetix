{
  "$id": "https://cydetix.dev/schemas/v1/agent-compatibility.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "cydetixVersion": {
      "type": "string"
    },
    "projectRoot": {
      "type": "string"
    },
    "projectRootCanonical": {
      "type": "boolean"
    },
    "runtimeVersion": {
      "type": "string"
    },
    "compatibilityTiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "tier-1-native-mcp",
              "tier-2-deterministic-cli",
              "tier-3-ci-report"
            ]
          },
          "level": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "level",
          "displayName",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "codex",
              "claude",
              "cursor",
              "copilot",
              "windsurf",
              "gemini",
              "cline",
              "roo",
              "continue",
              "goose",
              "generic-mcp"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "detected": {
            "type": "boolean"
          },
          "installationState": {
            "type": "string",
            "enum": [
              "installed",
              "not_installed"
            ]
          },
          "integrationState": {
            "type": "string",
            "enum": [
              "configured",
              "not_configured",
              "partially_configured",
              "unsupported_version",
              "configuration_inaccessible"
            ]
          },
          "compatibilityTier": {
            "type": "string",
            "enum": [
              "tier-1-native-mcp",
              "tier-2-deterministic-cli",
              "tier-3-ci-report"
            ]
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "mcpStdio": {
                "type": "boolean"
              },
              "mcpHttp": {
                "type": "boolean"
              },
              "projectScopedConfig": {
                "type": "boolean"
              },
              "userScopedConfig": {
                "type": "boolean"
              },
              "skills": {
                "type": "boolean"
              },
              "instructionFiles": {
                "type": "boolean"
              }
            },
            "required": [
              "mcpStdio",
              "mcpHttp",
              "projectScopedConfig",
              "userScopedConfig",
              "skills",
              "instructionFiles"
            ],
            "additionalProperties": false
          },
          "configured": {
            "type": "boolean"
          },
          "verified": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "configTargets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtimeVersion": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "detected",
          "installationState",
          "integrationState",
          "compatibilityTier",
          "capabilities",
          "configured",
          "verified",
          "evidence",
          "configTargets",
          "runtimeVersion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "cydetixVersion",
    "projectRoot",
    "projectRootCanonical",
    "runtimeVersion",
    "compatibilityTiers",
    "agents"
  ],
  "additionalProperties": false
}
