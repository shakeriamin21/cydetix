{
  "$id": "https://cydetix.dev/schemas/v1/trust-report.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "catalogueFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "controlRegistryFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "maturityCounts": {
      "type": "object",
      "properties": {
        "experimental": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "validated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "production": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "experimental",
        "validated",
        "production"
      ],
      "additionalProperties": false
    },
    "analysisEngines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proofCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safeRemediationAdapters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verificationStrategies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "securityControls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "proofEffect": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "context",
          "proofEffect"
        ],
        "additionalProperties": false
      }
    },
    "resourceBounds": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "unsupportedOrIncomplete": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "catalogueFingerprint",
    "controlRegistryFingerprint",
    "maturityCounts",
    "analysisEngines",
    "proofCapabilities",
    "safeRemediationAdapters",
    "verificationStrategies",
    "securityControls",
    "resourceBounds",
    "unsupportedOrIncomplete"
  ],
  "additionalProperties": false
}
