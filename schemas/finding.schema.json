{
  "$id": "https://cydetix.dev/schemas/v1/finding.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ruleId": {
      "type": "string"
    },
    "ruleVersion": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "reachability": {
      "type": "string",
      "enum": [
        "unknown",
        "unlikely",
        "possible",
        "likely",
        "confirmed"
      ]
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "affectedComponent": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "object",
          "properties": {
            "line": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "line",
            "column",
            "offset"
          ],
          "additionalProperties": false
        },
        "end": {
          "type": "object",
          "properties": {
            "line": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "line",
            "column",
            "offset"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "path",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "redacted": {
            "type": "boolean"
          }
        },
        "required": [
          "message",
          "excerpt",
          "redacted"
        ],
        "additionalProperties": false
      }
    },
    "evidencePath": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "route",
              "call",
              "identity",
              "enforcement",
              "resource",
              "credential",
              "authentication",
              "session",
              "token",
              "oauth",
              "validation",
              "revocation",
              "password-reset",
              "dependency",
              "advisory",
              "workflow",
              "secret"
            ]
          },
          "irId": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "line",
                  "column",
                  "offset"
                ],
                "additionalProperties": false
              },
              "end": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "line",
                  "column",
                  "offset"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "path",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "order",
          "kind",
          "irId",
          "location",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "securityInvariant": {
      "type": "string"
    },
    "attackPrerequisite": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "standards": {
      "type": "object",
      "properties": {
        "cwe": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CWE-\\d+$"
          }
        },
        "owaspTop10": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^A\\d{2}:2025$"
          }
        },
        "asvs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^v5\\.0\\.0-\\d+\\.\\d+\\.\\d+$"
          }
        },
        "nist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "cwe",
        "owaspTop10",
        "asvs",
        "nist"
      ],
      "additionalProperties": false
    },
    "remediation": {
      "type": "string"
    },
    "autofix": {
      "type": "string",
      "enum": [
        "SAFE",
        "REVIEW_REQUIRED",
        "ARCHITECTURAL"
      ]
    },
    "ruleMaturity": {
      "type": "string",
      "enum": [
        "EXPERIMENTAL",
        "VALIDATED",
        "PRODUCTION"
      ]
    },
    "proofState": {
      "type": "string",
      "enum": [
        "PROVEN_SECURE",
        "PROVEN_INSECURE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "analysisCompleteness": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNSUPPORTED",
        "TRUNCATED"
      ]
    },
    "proof": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "SOURCE",
                "PROPAGATION",
                "TRANSFORMATION",
                "CONTROL",
                "SINK"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "path",
                "line",
                "column"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "label",
            "location"
          ],
          "additionalProperties": false
        },
        "propagationPath": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "SOURCE",
                  "PROPAGATION",
                  "TRANSFORMATION",
                  "CONTROL",
                  "SINK"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "path",
                  "line",
                  "column"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "label",
              "location"
            ],
            "additionalProperties": false
          }
        },
        "sink": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "SOURCE",
                "PROPAGATION",
                "TRANSFORMATION",
                "CONTROL",
                "SINK"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "path",
                "line",
                "column"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "label",
            "location"
          ],
          "additionalProperties": false
        },
        "securityControlEncountered": {
          "type": "boolean"
        },
        "securityControlEvaluation": {
          "type": "string",
          "enum": [
            "ABSENT",
            "RECOGNIZED_EFFECTIVE",
            "RECOGNIZED_INEFFECTIVE",
            "UNKNOWN"
          ]
        },
        "reachability": {
          "type": "string",
          "enum": [
            "unknown",
            "unlikely",
            "possible",
            "likely",
            "confirmed"
          ]
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "proofState": {
          "type": "string",
          "enum": [
            "PROVEN_SECURE",
            "PROVEN_INSECURE",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1
        },
        "ruleMaturity": {
          "type": "string",
          "enum": [
            "EXPERIMENTAL",
            "VALIDATED",
            "PRODUCTION"
          ]
        },
        "cwe": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CWE-\\d+$"
          }
        },
        "asvs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^v5\\.0\\.0-\\d+\\.\\d+\\.\\d+$"
          }
        },
        "owaspTop10": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^A\\d{2}:2025$"
          }
        },
        "analysisLimitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schemaVersion",
        "source",
        "propagationPath",
        "sink",
        "securityControlEncountered",
        "securityControlEvaluation",
        "reachability",
        "invariant",
        "conclusion",
        "proofState",
        "ruleId",
        "ruleVersion",
        "ruleMaturity",
        "cwe",
        "asvs",
        "owaspTop10",
        "analysisLimitations"
      ],
      "additionalProperties": false
    },
    "remediationAssessment": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "ceiling": {
          "type": "string",
          "enum": [
            "SAFE",
            "REVIEW_REQUIRED",
            "ARCHITECTURAL"
          ]
        },
        "requestedClass": {
          "type": "string",
          "enum": [
            "SAFE",
            "REVIEW_REQUIRED",
            "ARCHITECTURAL"
          ]
        },
        "finalClass": {
          "type": "string",
          "enum": [
            "SAFE",
            "REVIEW_REQUIRED",
            "ARCHITECTURAL"
          ]
        },
        "reasonCodes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "EXACT_LOCAL_TRANSFORM",
              "DYNAMIC_EXPRESSION",
              "AMBIGUOUS_SEMANTICS",
              "BUSINESS_POLICY_REQUIRED",
              "AUTHORIZATION_POLICY_REQUIRED",
              "SCHEMA_CHANGE_REQUIRED",
              "CROSS_MODULE_UNCERTAINTY",
              "UNSUPPORTED_FRAMEWORK_PATTERN",
              "INSUFFICIENT_DATAFLOW_PROOF",
              "SANITIZER_UNKNOWN",
              "VERIFICATION_INSUFFICIENT",
              "MULTI_FILE_SEMANTIC_CHANGE",
              "ARCHITECTURE_CHANGE_REQUIRED"
            ]
          }
        },
        "safeConditions": {
          "type": "object",
          "properties": {
            "deterministicTransformation": {
              "type": "boolean"
            },
            "boundedLocalBlastRadius": {
              "type": "boolean"
            },
            "sourceHashVerified": {
              "type": "boolean"
            },
            "noBusinessPolicyDecision": {
              "type": "boolean"
            },
            "noAuthorizationPolicyInvention": {
              "type": "boolean"
            },
            "noArchitectureChange": {
              "type": "boolean"
            },
            "noSemanticAmbiguity": {
              "type": "boolean"
            },
            "noUnknownSecurityDependency": {
              "type": "boolean"
            },
            "independentInvariantVerification": {
              "type": "boolean"
            }
          },
          "required": [
            "deterministicTransformation",
            "boundedLocalBlastRadius",
            "sourceHashVerified",
            "noBusinessPolicyDecision",
            "noAuthorizationPolicyInvention",
            "noArchitectureChange",
            "noSemanticAmbiguity",
            "noUnknownSecurityDependency",
            "independentInvariantVerification"
          ],
          "additionalProperties": false
        },
        "verificationStrength": {
          "type": "string",
          "enum": [
            "NONE",
            "PATTERN",
            "INVARIANT"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "ceiling",
        "requestedClass",
        "finalClass",
        "reasonCodes",
        "safeConditions",
        "verificationStrength"
      ],
      "additionalProperties": false
    },
    "fix": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedTextSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "replacement": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "startOffset",
        "endOffset",
        "expectedTextSha256",
        "replacement",
        "description"
      ],
      "additionalProperties": false
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "not_attempted",
        "verified",
        "failed"
      ]
    },
    "suppression": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "findingFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "expires": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "reason",
        "owner"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "fingerprint",
    "ruleId",
    "ruleVersion",
    "severity",
    "confidence",
    "reachability",
    "title",
    "category",
    "affectedComponent",
    "location",
    "evidence",
    "securityInvariant",
    "attackPrerequisite",
    "impact",
    "standards",
    "remediation",
    "autofix",
    "verificationStatus"
  ],
  "additionalProperties": false
}
